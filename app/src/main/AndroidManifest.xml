<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.doggo">

    <!-- ✅ Existing permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ✅ NEW: Camera permission -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ✅ NEW: Read external storage (for gallery access on Android 12 and below) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ✅ NEW: For Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ✅ NEW: Camera feature (optional, not all devices have camera) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".DoggoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Doggo"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.Light.NoActionBar">

        <!-- Intro Activity (Launcher) -->
        <activity
            android:name=".IntroActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".SignInActivity"
            android:exported="false" />

        <activity
            android:name=".SignUpActivity"
            android:exported="false" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Home Activities -->
        <activity
            android:name=".Home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".Home.AddDogProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.doggo.Home.DogProfileDetailActivity"
            android:exported="false" />

        <activity
            android:name=".Home.EditDogProfileActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

    </application>

</manifest>