<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#F3F4F6">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Pet Image -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvPetImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivDogPhotoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_dog_placeholder"
                android:contentDescription="Pet photo" />

        </androidx.cardview.widget.CardView>

        <!-- Pet Info -->
        <LinearLayout
            android:id="@+id/llPetInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toEndOf="@id/cvPetImage"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Pet Name -->
            <TextView
                android:id="@+id/tvDogName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="doggo1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F2937" />

            <!-- Pet Breed -->
            <TextView
                android:id="@+id/tvDogBreed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="chicken"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp" />

            <!-- Pet Details -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <!-- Gender Icon -->
                <ImageView
                    android:id="@+id/ivGender"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_male"
                    android:tint="#6B7280"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Gender" />

                <TextView
                    android:id="@+id/tvGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Male"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginStart="4dp" />

                <!-- Weight Icon -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_weight"
                    android:tint="#6B7280"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Weight" />

                <TextView
                    android:id="@+id/tvWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22.0 kg"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Arrow Icon -->
        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#9CA3AF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="View details" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>